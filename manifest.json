{
  "manifest_version": 3,
  "name": "个人信息自动填写助手",
  "version": "3.3.15",
  "description": "DeepSeek AI 辅助定位表单和匹配字段，个人资料一键填写，经历及家庭成员由用户逐条选择。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "个人信息自动填写助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
