{
  "manifest_version": 3,
  "name": "个人信息自动填写助手",
  "version": "3.4.6",
  "description": "通用自适应表单引擎，支持复合日期与地区精度适配，并由 DeepSeek AI 辅助陌生页面识别。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "个人信息自动填写助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
